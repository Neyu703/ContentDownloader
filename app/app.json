{
  "expo": {
    "name": "Content Downloader",
    "slug": "content-downloader",
    "version": "1.5.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.contentdownloader.app",
      "versionCode": 12,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "packagingOptions": {
              "doNotStrip": [
                "**/libpython.zip.so",
                "**/libffmpeg.zip.so"
              ]
            },
            "extraProguardRules": "-keep class com.yausername.** { *; }\n-keep class com.fasterxml.jackson.** { *; }\n-keepnames class com.fasterxml.jackson.** { *; }\n-dontwarn com.fasterxml.jackson.databind.**\n-keepclassmembers class com.yausername.youtubedl_android.mapper.** { <fields>; <init>(...); }\n-keep class org.apache.commons.compress.** { *; }\n-dontwarn org.apache.commons.compress.**"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "88134826-f760-4889-8f71-090b31578be5"
      },
      "debugLogEmail": "REDACTED@example.com"
    }
  }
}
