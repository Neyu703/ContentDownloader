{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "app", "web", "--port", "8082"],
      "port": 8082
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "app", "run", "server:dev"],
      "port": 3001,
      "autoPort": true
    }
  ]
}
